{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "elevenlabs": {
      "type": "http",
      "url": "https://api.us.elevenlabs.io/v1/mcp"
    },
    "nationalparks": {
      "command": "npx",
      "args": ["-y", "mcp-server-nationalparks"],
      "env": {
        "NPS_API_KEY": "${NPS_API_KEY}"
      }
    },
    "datagov": {
      "command": "npx",
      "args": ["-y", "@melaodoidao/datagov-mcp-server"]
    }
  }
}
